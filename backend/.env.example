# 复制为 .env 后按需修改
DATABASE_URL=sqlite:///./course_agent.db
# 生产环境请改为随机长字符串
JWT_SECRET=dev-secret-change-me

# LLM（OpenAI 兼容接口，默认千问 DashScope；也可换 DeepSeek 等任何兼容服务）
# 千问：https://dashscope.aliyuncs.com/compatible-mode/v1  模型如 qwen-plus / qwen-flash / qwen-max
# DeepSeek：https://api.deepseek.com                      模型如 deepseek-chat
LLM_API_KEY=你的Key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 国内下载向量模型较慢时可启用 HuggingFace 镜像
# HF_ENDPOINT=https://hf-mirror.com
