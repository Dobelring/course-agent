# 复制为 .env 后按需修改
DATABASE_URL=sqlite:///./course_agent.db
# 生产环境请改为随机长字符串
JWT_SECRET=dev-secret-change-me

# LLM（OpenAI 兼容接口，默认千问 DashScope；也可换 DeepSeek 等任何兼容服务）
# 千问官方：https://dashscope.aliyuncs.com/compatible-mode/v1  模型如 qwen-plus / qwen-flash / qwen-max
# DeepSeek：https://api.deepseek.com                      模型如 deepseek-chat
LLM_API_KEY=你的Key
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-plus

# 国内下载向量模型较慢时可启用 HuggingFace 镜像
# HF_ENDPOINT=https://hf-mirror.com

# Redis（可选）：留空 = 全部走进程内缺省路径（单 worker 行为不变）。
# 配置后启用：多 worker 限流共享（Lua 令牌桶）/ 熔断状态共享 / 审批与取消
# 跨进程信号（Pub/Sub）/ MCP 工具缓存 L2+分布式单飞 / 检索结果缓存。
# 本地可跑：docker compose up -d redis（仓库根目录 docker-compose.yml）
# REDIS_URL=redis://127.0.0.1:6379/0
